{
  "info": {
    "name": "Study Assistant API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "admin_key",
      "value": "change-me"
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/health",
          "host": [
            "{{base}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('health reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "chat - fee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/chat",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"tuition for 18 credits and 2 retake\", \"session_id\": \"demo\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('chat returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('fee response follows contract', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.intent).to.eql('fee');",
              "  pm.expect(body.answer).to.include('9,450,000');",
              "  pm.expect(body.request_id).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "chat - rule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/chat",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"can I register my thesis with 118 credits\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rule chat returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('chat response contains sources', () => pm.expect(pm.response.json().sources).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "chat - empty (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/chat",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "chat"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('empty chat returns HTTP 422', () => pm.response.to.have.status(422));",
              "pm.test('validation error follows contract', () => pm.expect(pm.response.json().error.code).to.eql('invalid_request'));"
            ]
          }
        }
      ]
    },
    {
      "name": "feedback - add",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/feedback",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "feedback"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"request_id\": \"abc123\", \"rating\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('feedback returns HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('feedback is stored with metadata', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.expect(body.request_id).to.eql('abc123');",
              "  pm.expect(body.created_at).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "feedback - list (admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{admin_key}}"
          }
        ],
        "url": {
          "raw": "{{base}}/v1/feedback",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "feedback"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('admin feedback list returns HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('feedback list is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "weather",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/v1/weather",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "weather"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('weather returns 200 or graceful 503', () => pm.expect(pm.response.code).to.be.oneOf([200, 503]));",
              "pm.test('weather response follows the documented contract', () => {",
              "  const body = pm.response.json();",
              "  if (pm.response.code === 200) {",
              "    pm.expect(body.temperature_c).to.be.a('number');",
              "    pm.expect(body.description).to.be.a('string');",
              "  } else {",
              "    pm.expect(body.error.code).to.eql('weather_service_unavailable');",
              "  }",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
